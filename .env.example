PORT=8080
# Required: persistent account database directory. Railway volume mount: /data.
ZWOICE_DATA_DIR=/data
# Verified email authentication. Set actual secrets only in Railway variables.
ZWOICE_RESEND_API_KEY=
ZWOICE_MAIL_FROM=Zwoice <login@your-verified-domain.example>
ZWOICE_ADMIN_EMAIL=
# Protect the transactional email allowance. Increase with your provider plan.
ZWOICE_EMAIL_DAILY_LIMIT=90
# Recommended: Cloudflare Realtime TURN key ID + its API token.
ZWOICE_CF_TURN_KEY_ID=
ZWOICE_CF_TURN_API_TOKEN=
# Alternative: coturn (existing credentials expire; no Cloudflare-style revocation).
ZWOICE_TURN_URLS=
ZWOICE_TURN_SECRET=
ZWOICE_STUN_URLS=stun:stun.cloudflare.com:3478
# Central-observer candidate only; see docs/OBSERVERS.md before deploying.
ZWOICE_OBSERVER_TOKEN=
ZWOICE_OBSERVER_CAPACITY=20
