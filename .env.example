# Optional, for legacy/private API invitations only. Public desktop use needs no key.
# Generate locally: openssl rand -hex 32. Never commit the actual key.
ZWOICE_SIGNING_KEY=
PORT=8080
# Recommended: Cloudflare Realtime TURN key ID + its API token.
ZWOICE_CF_TURN_KEY_ID=
ZWOICE_CF_TURN_API_TOKEN=
# Alternative: coturn with use-auth-secret and a shared static-auth-secret.
ZWOICE_TURN_URLS=
ZWOICE_TURN_SECRET=
# Optional override; defaults to Cloudflare's public STUN endpoint.
ZWOICE_STUN_URLS=stun:stun.cloudflare.com:3478
